{
  "base_url": "http://127.0.0.1:8000",
  "steps": [
    {
      "name": "healthcheck",
      "method": "GET",
      "path": "/health",
      "expected_status": 200,
      "expected_keys": ["status", "database_status", "kafka_status"]
    },
    {
      "name": "training-data-summary",
      "method": "GET",
      "path": "/training-data/summary",
      "expected_status": 200,
      "expected_keys": ["splits"]
    },
    {
      "name": "predict-quality",
      "method": "POST",
      "path": "/predict",
      "expected_status": 200,
      "expected_keys": ["predicted_quality", "model_version", "prediction_id", "stored_in_db", "published_to_kafka"],
      "response_contains": {"stored_in_db": true, "published_to_kafka": true},
      "json": {
        "fixed_acidity": 7.4,
        "volatile_acidity": 0.7,
        "citric_acid": 0.0,
        "residual_sugar": 1.9,
        "chlorides": 0.076,
        "free_sulfur_dioxide": 11,
        "total_sulfur_dioxide": 34,
        "density": 0.9978,
        "ph": 3.51,
        "sulphates": 0.56,
        "alcohol": 9.4
      }
    },
    {
      "name": "latest-prediction",
      "method": "GET",
      "path": "/predictions/latest",
      "expected_status": 200,
      "expected_keys": ["prediction_id", "predicted_quality", "model_version", "request_payload", "created_at"]
    },
    {
      "name": "latest-kafka-event",
      "method": "GET",
      "path": "/prediction-events/latest",
      "expected_status": 200,
      "expected_keys": ["event_id", "prediction_id", "predicted_quality", "model_version", "request_payload", "published_at", "consumed_at"]
    }
  ]
}